<!DOCTYPE html>
<html lang="ko">
<head>
<meta charset="UTF-8">
<title>JIPYO 워크북 디자인 실시간 미리보기</title>
<style>
  body {
    margin: 0;
    padding: 0;
    font-family: sans-serif;
    background: #1e293b;
    color: #fff;
    display: flex;
    height: 100vh;
    overflow: hidden;
  }
  #sidebar {
    width: 260px;
    background: #0f172a;
    padding: 20px;
    box-sizing: border-box;
    display: flex;
    flex-direction: column;
    gap: 10px;
    border-right: 1px solid #334155;
  }
  #sidebar h2 {
    font-size: 16px;
    margin-bottom: 10px;
    color: #38bdf8;
  }
  .page-btn {
    background: #1e293b;
    color: #cbd5e1;
    border: 1px solid #334155;
    padding: 10px 14px;
    border-radius: 8px;
    cursor: pointer;
    text-align: left;
    font-size: 13px;
    transition: all 0.2s;
  }
  .page-btn:hover, .page-btn.active {
    background: #0284c7;
    color: #fff;
    border-color: #38bdf8;
  }
  #preview-container {
    flex: 1;
    padding: 20px;
    overflow-y: auto;
    display: flex;
    justify-content: center;
    background: #334155;
  }
  iframe {
    width: 210mm;
    height: 297mm;
    border: none;
    background: #fff;
    box-shadow: 0 10px 30px rgba(0,0,0,0.5);
  }
</style>
</head>
<body>

<div id="sidebar">
  <h2>📖 워크북 페이지 선택</h2>
  <button class="page-btn active" onclick="showPage(1)">1페이지: 표지 (오늘의 질문)</button>
  <button class="page-btn" onclick="showPage(2)">2페이지: 읽기 전 생각</button>
  <button class="page-btn" onclick="showPage(3)">3페이지: 영상으로 만나기</button>
  <button class="page-btn" onclick="showPage(4)">4페이지: 핵심 개념 카드</button>
  <button class="page-btn" onclick="showPage(5)">5페이지: 읽기지문 (1/2)</button>
  <button class="page-btn" onclick="showPage(6)">6페이지: 읽기지문 (2/2)</button>
  <button class="page-btn" onclick="showPage(7)">7페이지: Fact Check</button>
  <button class="page-btn" onclick="showPage(8)">8페이지: 사실/해석/주장 구분</button>
  <button class="page-btn" onclick="showPage(9)">9페이지: 호기심 이어가기</button>
  <button class="page-btn" onclick="showPage(10)">10페이지: 치료와 과잉치료</button>
  <button class="page-btn" onclick="showPage(11)">11페이지: 세 문장 요약</button>
  <button class="page-btn" onclick="showPage(12)">12페이지: 타인 시점 보기</button>
  <button class="page-btn" onclick="showPage(13)">13페이지: 나의 판단과 조건</button>
  <button class="page-btn" onclick="showPage(14)">14페이지: 글쓰기 활동</button>
</div>

<div id="preview-container">
  <iframe id="viewer"></iframe>
</div>

<script>
  // 이전에 작성된 워크북 HTML 전체 데이터
  const htmlContent = `[이전에 제공된 전체 HTML 코드]`;

  // 페이지 이동 함수
  function showPage(pageNum) {
    const btns = document.querySelectorAll('.page-btn');
    btns.forEach((btn, idx) => {
      if (idx === pageNum - 1) btn.classList.add('active');
      else btn.classList.remove('active');
    });

    const iframe = document.getElementById('viewer');
    const doc = iframe.contentWindow.document;
    
    // 선택한 페이지 부근으로 스크롤 이동
    doc.open();
    doc.write(htmlContent);
    doc.close();

    setTimeout(() => {
      const pages = doc.querySelectorAll('.page');
      if (pages[pageNum - 1]) {
        pages[pageNum - 1].scrollIntoView({ behavior: 'smooth' });
      }
    }, 100);
  }

  // 초기 로드
  window.onload = () => showPage(1);
</script>

</body>
</html>
